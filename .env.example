# Configuração do Ozempic Seguro
# Copie para .env e ajuste. Variáveis definidas no ambiente têm prioridade sobre este arquivo.

# development ativa logs detalhados no console
OZEMPIC_ENV=production

# Usuários criados na primeira execução (usuário e senha só com números, senha de 4 a 8 dígitos)
OZEMPIC_ADMIN_USERNAME=00
OZEMPIC_ADMIN_PASSWORD=
OZEMPIC_TECNICO_USERNAME=01
OZEMPIC_TECNICO_PASSWORD=

# Opcionais (valores padrão abaixo)
# OZEMPIC_SESSION_TIMEOUT=10        # minutos sem uso até a sessão expirar
# OZEMPIC_MAX_LOGIN_ATTEMPTS=3      # tentativas antes do bloqueio
# OZEMPIC_LOCKOUT_DURATION=5        # minutos de bloqueio por tentativas
# OZEMPIC_DRAWER_LOCK_MINUTES=5     # minutos de bloqueio após abrir uma gaveta
# OZEMPIC_BCRYPT_ROUNDS=12          # entre 10 e 16
# OZEMPIC_DB_PATH=                  # caminho do arquivo SQLite
